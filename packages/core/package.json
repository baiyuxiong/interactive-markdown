{
  "name": "@interactive-markdown/core",
  "version": "0.2.0",
  "description": "Parse and validate Interactive Markdown (IMD)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baiyuxiong/interactive-markdown.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/baiyuxiong/interactive-markdown#readme",
  "bugs": {
    "url": "https://github.com/baiyuxiong/interactive-markdown/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
